# Token de @BotFather (obligatorio)
TELEGRAM_BOT_TOKEN=

# IDs de chat autorizados, separados por comas. Si está vacío, el bot
# rechazará a todo el mundo y te dirá tu chat_id al escribirle.
ALLOWED_CHAT_IDS=

# Chats con permiso para /actualizar (administración). Si está vacío se usan
# los mismos que ALLOWED_CHAT_IDS.
ADMIN_CHAT_IDS=

# Ruta de la base de datos SQLite
DATABASE_PATH=./tracker.db

# Intervalos de comprobación (segundos)
DEFAULT_INTERVAL_SECONDS=90
MIN_INTERVAL_SECONDS=60
MAX_NOTIFICATIONS_PER_CHECK=15

# Días que se conservan los IDs de anuncios ya avisados
SEEN_RETENTION_DAYS=60

# Mercados (cambia el dominio si usas otro país)
WALLAPOP_BASE_URL=https://es.wallapop.com
WALLAPOP_API_BASE=https://api.wallapop.com
VINTED_BASE_URL=https://www.vinted.es
VINTED_LOCALE=es-ES

# Red y logs
REQUEST_TIMEOUT_SECONDS=25
LOG_LEVEL=INFO
