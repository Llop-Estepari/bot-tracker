[Unit]
Description=Bot tracker de anuncios Wallapop y Vinted
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tracker
Group=tracker
WorkingDirectory=/opt/bot-tracker
EnvironmentFile=/opt/bot-tracker/.env
ExecStart=/opt/bot-tracker/.venv/bin/python /opt/bot-tracker/main.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
